{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "engine": "ChromaMatrix Core",
  "version": "3.0.0",
  "architectural_layer": "ManifestVault",
  "description": "Sprite animation matrices, state machines, squash & stretch kinetics, autotile Wang-masks, retro UI, and VFX particle emitters.",
  "animation_state_machines": {
    "character_4way_matrix": {
      "name": "Standard 4-Way Character Animation State Machine",
      "frame_dimensions": [32, 32],
      "directions": ["SOUTH", "WEST", "EAST", "NORTH"],
      "states": {
        "idle": { "frame_count": 4, "fps": 6, "loop": true, "row_index": 0 },
        "walk": { "frame_count": 8, "fps": 12, "loop": true, "row_index": 1 },
        "run": { "frame_count": 6, "fps": 16, "loop": true, "row_index": 2 },
        "jump_squash_stretch": { "frame_count": 5, "fps": 14, "loop": false, "row_index": 3, "kinetics": ["squash_0.8x1.2", "stretch_1.2x0.8"] },
        "melee_slash": { "frame_count": 6, "fps": 18, "loop": false, "row_index": 4 },
        "spell_cast": { "frame_count": 6, "fps": 12, "loop": false, "row_index": 5 },
        "damage_flinch": { "frame_count": 3, "fps": 12, "loop": false, "row_index": 6 },
        "death_dissolve": { "frame_count": 8, "fps": 8, "loop": false, "row_index": 7 }
      }
    },
    "character_8way_matrix": {
      "name": "Advanced 8-Way Directional Character State Machine",
      "frame_dimensions": [32, 32],
      "directions": ["SOUTH", "SOUTH_WEST", "WEST", "NORTH_WEST", "NORTH", "NORTH_EAST", "EAST", "SOUTH_EAST"],
      "states": {
        "idle": { "frame_count": 4, "fps": 6, "loop": true },
        "walk": { "frame_count": 8, "fps": 12, "loop": true },
        "run": { "frame_count": 8, "fps": 16, "loop": true },
        "melee_attack": { "frame_count": 6, "fps": 18, "loop": false },
        "death": { "frame_count": 8, "fps": 8, "loop": false }
      }
    }
  },
  "autotile_rulesets": {
    "isometric_terrain_48": {
      "name": "Isometric Axonometric Terrain Autotile",
      "tile_dimensions": [48, 48],
      "projection": "30_degree_axonometric",
      "tile_variations": 16,
      "edge_masking": "wang_2x2_corner"
    },
    "topdown_dungeon_32": {
      "name": "Top-Down Dungeon Bitmask Tileset",
      "tile_dimensions": [32, 32],
      "projection": "orthographic_topdown",
      "tile_variations": 47,
      "edge_masking": "wang_3x3_blob"
    },
    "sidescroller_platform_16": {
      "name": "Side-Scroller Platform Tileset",
      "tile_dimensions": [16, 16],
      "projection": "orthographic_side",
      "tile_variations": 16,
      "seamless_wrapping": "horizontal_x_axis"
    }
  },
  "retro_ui_framework": {
    "arcade_button_set": {
      "frame_dimensions": [32, 16],
      "states": ["normal", "hovered", "pressed", "disabled"]
    },
    "health_mana_meters": {
      "frame_dimensions": [64, 12],
      "components": ["border_frame", "fill_segmented", "glow_overlay"]
    },
    "inventory_grid_9slice": {
      "tile_dimensions": [16, 16],
      "slice_margins": [4, 4, 4, 4]
    },
    "pixel_typography_5x7": {
      "glyph_dimensions": [5, 7],
      "character_map": "ASCII_32_to_126",
      "monospaced": true
    }
  },
  "vfx_particle_emitters": {
    "plasma_fire_explosion": {
      "frame_dimensions": [32, 32],
      "frame_count": 8,
      "fps": 24,
      "blend_mode": "additive"
    },
    "elemental_magic_aura": {
      "frame_dimensions": [32, 32],
      "frame_count": 6,
      "fps": 12,
      "elements": ["fire", "frost", "shock", "holy", "dark"]
    },
    "weather_particle_vectors": {
      "frame_dimensions": [16, 16],
      "vectors": ["rain_drop", "snow_flake_swirl", "fog_cloud_density"]
    }
  }
}
